# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# custom debug and scripts
*.log
*.txt
*.py
ai-backend/venv/
__pycache__/
*.pyc

# keep standalone ATS module source tracked
!ai-backend/resume_screening/
!ai-backend/resume_screening/**/*.py
!ai-backend/resume_screening/**/*.md
!ai-backend/resume_screening/**/*.txt
!ai-backend/resume_screening/**/*.json
!ai-backend/resume_screening/**/requirements.txt

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
