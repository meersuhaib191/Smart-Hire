# Copy to .env.local and fill values from Supabase Dashboard → Project Settings → API.
# Project URL looks like: https://YOUR_PROJECT_REF.supabase.co

# Reference ID (subdomain before .supabase.co) — used if NEXT_PUBLIC_SUPABASE_URL is omitted
NEXT_PUBLIC_SUPABASE_PROJECT_ID=

# Optional; if set, overrides the URL built from PROJECT_ID
NEXT_PUBLIC_SUPABASE_URL=

# anon / public key (safe for browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key — server only; never expose to the client. Required for /api/auth/sync-profile
SUPABASE_SERVICE_ROLE_KEY=

# Optional ATS tuning
ATS_PASS_SCORE=60

# Optional embedding provider (recommended for production ATS semantic quality)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_LLM_MODEL=gpt-4o-mini

# Optional MCQ stage tuning
MCQ_PASS_SCORE=60
MCQ_EXAM_DURATION_SECONDS=900
MCQ_EXAM_GRACE_SECONDS=30
MCQ_SESSION_SECRET=

# Optional Interview stage tuning
INTERVIEW_PASS_SCORE=60

# Judge0 (or compatible) code execution backend
JUDGE0_API_URL=
JUDGE0_API_KEY=

# Python ATS service URL used by /api/apply (no trailing slash)
AI_BACKEND_URL=http://127.0.0.1:8000

# For ai-backend deployment (comma-separated frontend origins)
AI_ALLOWED_ORIGINS=http://localhost:3000

# Optional Coding stage tuning
CODING_PASS_SCORE=60
